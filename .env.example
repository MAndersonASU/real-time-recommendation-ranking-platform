# Copy to .env (gitignored, never committed) to override any of these.
# Every value below is the same default the app already falls back to,
# so an empty or missing .env changes nothing.

REDIS_URL=redis://localhost:6379/0
API_PORT=8000

# No real secret exists in this project yet -- this slot is here so one
# never has to be hardcoded if Redis auth is ever turned on. Leave unset.
# REDIS_PASSWORD=
