# Copy to .env (gitignored, never committed) to override any of these.
# Every value below is the same default the app already falls back to,
# so an empty or missing .env changes nothing.

REDIS_URL=redis://localhost:6379/0
API_PORT=8000

# No real secret exists in this project yet -- this slot is here so one
# never has to be hardcoded if Redis auth is ever turned on. Leave unset.
# Setting this now actually enforces it (docker-compose.yml wires it into
# both the redis service's --requirepass and the api container's own
# environment) -- it used to be carried through the app's config with no
# corresponding requirepass on the Redis service at all, so it did
# nothing. Leaving it unset changes nothing from before.
# REDIS_PASSWORD=
